# Agent image (IMG-03): the published base image plus what ARC-01 and the acceptance tests need.
# The base image has no socat, dig, ip, or xxd.
FROM ghcr.io/bugrasan/devcontainer-base-ai/base:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

# socat: egress bridge; dnsutils, iproute2, xxd: acceptance tests (AT-07, AT-09)
# sudo is removed: the agent image ships no sudo or setuid helpers (HRD-02)
RUN apt-get update \
    && apt-get install -y --no-install-recommends socat dnsutils iproute2 xxd \
    && apt-get purge -y sudo \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER vscode
