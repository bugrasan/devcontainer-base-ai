# Copy to .env in this folder (compose reads it from the project folder); never commit .env
# Compose project name: lowercase letters, digits, and '-'; starts with a letter; at most 40 characters
P=agent-a
# Absolute path of the project workspace; no '#', '&', '"', or '\'; must not contain this folder
WS=/abs/path/to/project
# Docker only: your `id -u` and `id -g` (rootless Podman uses cfg-01-compose-podman.yaml instead)
AGENT_UID=1000
AGENT_GID=1000
# Optional image tags (defaults shown); `docker compose build` tags the build results with them
# AGENT_IMAGE=localhost/agent:1
# SQUID_IMAGE=localhost/squid:1
