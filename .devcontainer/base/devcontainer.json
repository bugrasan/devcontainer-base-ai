// This devcontainer is not meant to be opened directly in VS Code.
// It exists solely so that `.github/workflows/publish-base-image.yml` can build
// and publish a pre-baked image (Dockerfile.trixie + these Features) to:
//   ghcr.io/bugrasan/devcontainer-base-ai/base:latest
// which the root ../devcontainer.json then consumes via its "image" property.
{
	"name": "devcontainer-base-ai base image",

	// Same Dockerfile used by the root ../devcontainer.json's commented-out "build" alternative.
	"build": {
		"dockerfile": "Dockerfile.mcr-trixie"
	},

	// Run an init process as PID 1 that forwards signals and reaps orphaned
	// child processes: tini with Docker ('docker run --init'), catatonit with
	// Podman ('podman run --init'). Stored in the image's devcontainer.metadata
	// label, so every devcontainer.json that uses this image inherits it and
	// can't turn it off: the CLI enables init if any metadata entry sets it.
	"init": true,

	// Same Features as the root devcontainer.json, baked into the image at build time.
	"features": {
		// https://github.com/devcontainers/features/blob/main/src/common-utils/
		"ghcr.io/devcontainers/features/common-utils:2": {
			"username": "vscode",
			// already done in container
			"upgradePackages": false,
		},

		// https://github.com/devcontainers/features/tree/main/src/sshd
		// SSHD_PORT/START_SSHD default to 2222/false in the Feature itself, which is
		// what we want - see root ../devcontainer.json's 'forwardPorts' comment.
		// "ghcr.io/devcontainers/features/sshd:1": {},

		// https://github.com/devcontainers/features/blob/main/src/node/
		// nodeGypDependencies/pnpmVersion explicitly disabled: their defaults (true /
		// "latest") pull in a full C/C++ build toolchain and pnpm, neither of which
		// anything here uses (only npm, for the npm-packages Feature) - this was the
		// single largest layer in the image (~509MB of ~1.44GB total), dominating
		// build/push time.
		"ghcr.io/devcontainers/features/node:2": {
			"version": "24",
			"nodeGypDependencies": false,
			"pnpmVersion": "none"
		},

		// https://github.com/devcontainers/features/blob/main/src/python/
		"ghcr.io/devcontainers/features/python:1": {
			"version": "os-provided"
		},

		// https://github.com/devcontainers/features/blob/main/src/github-cli/
		"ghcr.io/devcontainers/features/github-cli:1": {},

		// https://github.com/devcontainers/features/blob/main/src/copilot-cli/
		"ghcr.io/devcontainers/features/copilot-cli:1": {},

		// Local Feature (./features/npm-packages) - installsAfter node, since it
		// needs npm. Same packages previously installed via postCreateCommand,
		// plus the npm language servers (bash, yaml, json/html/css, dockerfile).
		// typescript-language-server stays for projects with a local TypeScript
		// <=6; no plugin uses it (TypeScript 7 runs as 'tsc --lsp --stdio').
		"./features/npm-packages": {},

		// Local Feature (./features/lsp-servers) - language-server binaries npm
		// doesn't ship (marksman, taplo) into ~/.local/bin. jdtls, terraform-ls and
		// LemMinx are available there as commented-out blocks.
		"./features/lsp-servers": {},

		// Local Feature (./features/lsp-config) - bakes the local plugin marketplace
		// 'base-ai-lsp' (/usr/local/share/base-ai-lsp, one plugin per language
		// server), installs it for Copilot CLI and Claude Code at user scope, and
		// writes ~/.claude/CLAUDE.md (Claude Code bias). installsAfter claude-code/
		// copilot-cli/node, since it runs both CLIs. ENABLE_LSP_TOOL and Claude's
		// pyright plugin come from the 'claude-code' Feature below.
		"./features/lsp-config": {},

		// Published from https://github.com/bugrasan/devcontainers-features/tree/main/src/claude-code
		// self-contained native binary installer, no npm/node dependency.
		// Also installs the LSP plugins in 'lspPlugins' at user scope and sets
		// ENABLE_LSP_TOOL=1. The binary pyright-langserver comes from npm-packages.
		"ghcr.io/bugrasan/devcontainers-features/claude-code:1": {
			// Not the default, which adds typescript-lsp@claude-plugins-official: it
			// runs typescript-language-server, which fails with TypeScript 7 (no
			// lib/tsserver.js, see
			// https://github.com/typescript-language-server/typescript-language-server/issues/1110).
			// TypeScript comes from typescript-lsp@base-ai-lsp (./features/lsp-config).
			"lspPlugins": "pyright-lsp@claude-plugins-official"
			// Java: after enabling jdtls in ./features/lsp-servers, use instead:
			//   "lspPlugins": "pyright-lsp@claude-plugins-official jdtls-lsp@claude-plugins-official"
		},

		// Published from https://github.com/bugrasan/devcontainers-features/tree/main/src/speckit
		// installs the 'specify' CLI (Spec-Driven Development) via uv. Requires Python 3.11+
		// (the python Feature above) and uv (baked into Dockerfile.mcr-trixie), both
		// already present, so it neither installs nor depends on them (installsAfter
		// python only, for cache ordering).
		"ghcr.io/bugrasan/devcontainers-features/speckit:1": {},

		// Published from https://github.com/bugrasan/devcontainers-features - installs
		// the OpenTelemetry Collector Contrib binary (otelcol-contrib, multi-arch
		// tarball from open-telemetry/opentelemetry-collector-releases) plus a default
		// OTLP -> Azure Application Insights config at /etc/otelcol-contrib/config.yaml.
		// autoStart is explicitly disabled: the Feature's postStartCommand hook
		// (/usr/local/share/otel-collector-contrib/start.sh) has AUTO_START=false baked
		// in at image-build time and exits immediately on every container start, so
		// nothing runs and nothing listens on 4317/4318 unless started manually:
		//   otelcol-contrib --config /etc/otelcol-contrib/config.yaml
		// (the default config resolves ${env:APPLICATIONINSIGHTS_CONNECTION_STRING}
		// at collector startup, so export it first - it is never baked into the image).
		"ghcr.io/bugrasan/devcontainers-features/otel-collector-contrib:1": {
			"autoStart": false
		},

		// Published from https://github.com/bugrasan/devcontainers-features/tree/main/src/superfile
		"ghcr.io/bugrasan/devcontainers-features/superfile:1": {},

		// Published from https://github.com/bugrasan/devcontainers-features/tree/main/src/herdr
		// Installs the herdr TUI ('herdr') and herdr-core ('hc') by running
		// upstream's official install scripts unchanged, as the remote user, into
		// ~/.local/bin (on PATH via Dockerfile.mcr-trixie). The build needs
		// herdr.dev, github.com,
		// release-assets.githubusercontent.com, releases.herdr.dev and
		// raw.githubusercontent.com. The herdr TUI is always the latest
		// release; the weekly no-cache rebuild picks up new ones. Nothing is
		// started at container start:
		// run 'herdr' to open or reattach to a session; the core starts on
		// first use of 'hc'.
		// Defaults are kept: a container-friendly ~/.config/herdr/config.toml
		// (skips the first-run wizard, stops both background calls to herdr.dev),
		// bash/zsh completions, and the herdr-core agent skill for Claude Code
		// (~/.claude/skills) and Copilot CLI (~/.copilot/skills). herdr's own
		// skill is off by default. The herdr-core skill is NOT inert: it matches
		// sub-agent and background-task work, and outside an hc terminal it asks
		// the user once per session whether to use hc.
		"ghcr.io/bugrasan/devcontainers-features/herdr:3": {}
	}
}
