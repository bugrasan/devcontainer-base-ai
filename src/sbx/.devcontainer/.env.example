# Template for .env; sbx-init.sh copies it on the first run and fills in P, AGENT_UID, and AGENT_GID
# Compose reads .env from this folder; never commit .env (.gitignore)
# Compose project name: lowercase letters, digits, '-', and '_'; starts with a letter or digit
P=sbx-project
# Docker only: your `id -u` and `id -g` (rootless Podman uses cfg-01-compose-podman.yaml instead)
AGENT_UID=1000
AGENT_GID=1000
# Optional image overrides (defaults shown); `up --build` tags its build results with these names
# AGENT_IMAGE=ghcr.io/bugrasan/devcontainer-base-ai/sbx-agent:latest
# PROXY_IMAGE=ghcr.io/bugrasan/devcontainer-base-ai/sbx-proxy:latest
# Managed by sbx-init.sh: the project folder name, mounted at /workspaces/$PROJECT; do not edit
PROJECT=
